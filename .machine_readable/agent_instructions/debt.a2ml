[[debt.could]]
component = "deno.lock"
issue = "A ~90 KB deno.lock sits in the repository root, but #43 (2026-08-24) deleted deno.json and every deno task. It is an orphan and it is the single most likely thing to make a reviewer think this is a Deno project."
effort = "easy"
impact = "medium"
discovered = "2026-09-27"
note = "Deleting it is safe, but confirm with the owner first — it may be referenced by an estate tool outside this checkout."

[[debt.could]]
